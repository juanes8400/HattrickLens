# Variables de entorno para publicar HT Lens.
#
# Ninguna tiene valor por defecto seguro: las tres claves de abajo se generan
# una vez y NO se comparten ni se suben al repositorio. Si alguna se filtra, se
# regenera y todas las sesiones y tokens guardados dejan de valer, que es
# justo lo que se quiere.

# ── Obligatorias ────────────────────────────────────────────────────────────

# "production" activa las cookies `secure` y apaga la sesión de desarrollo.
ENVIRONMENT=production

# Postgres del hosting. En local vale sqlite+aiosqlite:///dev.db
DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/htlens

# Firma las cookies de sesión.  Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cifra los tokens CHPP guardados en la base (Fernet). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── CHPP ────────────────────────────────────────────────────────────────────
#
# Se piden en https://chpp.hattrick.org registrando la aplicación. La URL de
# retorno debe ser EXACTAMENTE la del dominio publicado, o Hattrick rechaza el
# intercambio de tokens.
CHPP_CONSUMER_KEY=
CHPP_CONSUMER_SECRET=
CHPP_CALLBACK_URL=https://tu-dominio/api/v1/auth/chpp/callback

# Hattrick pide identificarse en cada llamada. Pon el nombre real de tu app y
# una forma de contacto: es lo que miran si algo se comporta mal.
CHPP_USER_AGENT=HattrickLens/1.0 (contacto: tu-correo)

# ── Opcionales ──────────────────────────────────────────────────────────────

# El sitio al que se vuelve tras autorizar. Con la app sirviendo su propio
# frontend, es el dominio a secas.
FRONTEND_URL=https://tu-dominio

# Orígenes permitidos. Sirviendo el frontend desde la misma app no hace falta
# ninguno; solo si separas pantalla y API en dos dominios.
# CORS_ORIGINS=["https://tu-dominio"]

LOG_LEVEL=INFO

# Tu ID de usuario de Hattrick (el <UserID> de cualquier fichero CHPP).
# Abre la pantalla de uso, y NADA mas. Vacio = no entra nadie, ni tu:
# falla cerrado a proposito.
ADMIN_HT_USER_ID=
